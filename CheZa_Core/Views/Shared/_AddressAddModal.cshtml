        // Обработчик события клика на карте
        myMap.events.add('click', function (e) {
            if (isZooming || isClickProcessed) return; // Проверяем, что не в процессе зумирования и клик уже не обработан
            var coords = e.get('coords');
            console.log('Клик на карте, координаты:', coords);
            isClickProcessed = true; // Устанавливаем флаг, что клик обработан
            raiseMarker();
            getAddress(coords);
            myMap.panTo(coords, {
                delay: 0,
                flying: true,
                checkZoomRange: true,
                duration: 300 // Ускорение анимации панорамирования
            }).then(function () {
                console.log('Панорамирование завершено');
                isClickProcessed = false; // Сбрасываем флаг после завершения панорамирования
                lowerMarker();
            });
        });

        // Обработчик начала перетаскивания карты
        myMap.events.add('actionbegin', function (e) {
            var originalEvent = e.get('originalEvent');
            if (originalEvent && (originalEvent.type === 'wheel' || originalEvent.type === 'dblclick' || originalEvent.type === 'tap')) {
                return;
            }
            console.log('actionbegin - начало перетаскивания');
            isDragging = true;
            raiseMarker();
        });

        // Обработчик завершения перетаскивания карты
        myMap.events.add('actionend', function (e) {
            if (isZooming) return; // Не обрабатывать завершение действия во время зумирования
            console.log('actionend - завершение перетаскивания');
            if (isDragging) {
                isDragging = false;
                var coords = myMap.getCenter();
                getAddress(coords);
                lowerMarker();
            }
        });

        // Обработчик изменения зума
        myMap.events.add('boundschange', function (e) {
            if (e.get('oldZoom') != e.get('newZoom')) {
                console.log('Изменение зума');
                isZooming = true;
                setTimeout(function () {
                    isZooming = false;
                }, 200);
            }
        });

        // Отключаем поведение scrollZoom
        myMap.behaviors.disable('scrollZoom');
    }

   

    document.getElementById('city-input').addEventListener('change', function () {
        searchAddress();
    });

    document.getElementById('street-input').addEventListener('change', function () {
        searchAddress();
    });

    document.getElementById('house-input').addEventListener('change', function () {
        searchAddress();
    });

    function searchAddress() {
        var city = document.getElementById('city-input').value || "";
        var street = document.getElementById('street-input').value || "";
        var house = document.getElementById('house-input').value || "";

        var address = city + ', ' + street + ', ' + house;

        console.log('Ищем адрес:', address);

        ymaps.geocode(address).then(function (res) {
            var coords = res.geoObjects.get(0).geometry.getCoordinates();

            myMap.setCenter(coords, 16);
            marker.geometry.setCoordinates(coords); // Обновляем координаты маркера
            raiseMarker();
            getAddress(coords);
        });
    }

    function deleteAddress() {
        var id = @Html.Raw(Json.Serialize(Model.addressId));
        var city = document.getElementById('city-input').value || "";
        var streetAddress = document.getElementById('street-input').value || "";
        var house = document.getElementById('house-input').value || "";
        var entrance = document.getElementById('entrance-input').value || "";
        var floor = document.getElementById('floor-input').value || "";
        var apartment = document.getElementById('apartment-input').value || "";
        var comment = document.getElementById('comment-input').value || "";

        var data = {
            addressId: id,
            streetAddress: streetAddress,
            house: house,
            city: city,
            floor: floor === "" ? null : parseInt(floor, 10),
            entrance: entrance === "" ? null : parseInt(entrance, 10),
            apartment: apartment === "" ? null : parseInt(apartment, 10),
            comment: comment,
            isEdit: @Html.Raw(Json.Serialize(Model.isEdit))
            };

        console.log('Send data: ', data);

        $.ajax({
            type: "POST",
            url: "/Profile/DeleteAddress",
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (response) {
                if (response.success) {
                    alert(response.message);
                    closeModal();
                } else {
                    alert(response.message);
                }
            },
            error: function (error) {
                if (error.status == 401) {
                    alert('Необходимо авторизоваться!');
                } else {
                    console.error("Ошибка при отправке адреса на сервер:", error);
                }
            }
        });
    }

    function submitAddress() {
        var id = @Html.Raw(Json.Serialize(Model.addressId));
        var city = document.getElementById('city-input').value || "";
        var streetAddress = document.getElementById('street-input').value || "";
        var house = document.getElementById('house-input').value || "";
        var entrance = document.getElementById('entrance-input').value || "";
        var floor = document.getElementById('floor-input').value || "";
        var apartment = document.getElementById('apartment-input').value || "";
        var comment = document.getElementById('comment-input').value || "";

        if (city === "" || streetAddress === "" || house === "") {
            alert("Выберите адрес!");
            return;
        }

        if (comment.length > 200) {
            alert('Слишком длинный комментарий!');
            return;
        }

        var data = {
            addressId: id,
            streetAddress: streetAddress,
            house: house,
            city: city,
            floor: floor === "" ? null : parseInt(floor, 10),
            entrance: entrance === "" ? null : parseInt(entrance, 10),
            apartment: apartment === "" ? null : parseInt(apartment, 10),
            comment: comment,
            isEdit: @Html.Raw(Json.Serialize(Model.isEdit))
        };

        console.log('Send data: ', data);

        $.ajax({
            type: "POST",
            url: "/Profile/SetAddress",
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (response) {
                if (response.success) {
                    console.log("Адрес успешно отправлен на сервер");
                    alert('Адрес успешно добавлен!');
                    closeModal();
                } else if (!response.success && response.message == "Город не найден") {
                    alert('К сожалению мы не доставляем в данный город(');
                } else {
                    alert(response.message);
                }
            },
            error: function (error) {
                if (error.status == 401) {
                    alert('Необходимо авторизоваться!');
                } else {
                    console.error("Ошибка при отправке адреса на сервер:", error);
                }
            }
        });
    }

    function closeModal() {
        document.getElementById('address-modal').style.display = 'none';

        $('body').css({
            'overflow-y': '',
            'padding-right': ''
        });
    }

    ymaps.ready(init);
    function init() {
        var map = new ymaps.Map('map', {
            center: [55.751574, 37.573856], // Координаты центра карты
            zoom: 10,
            controls: ['zoomControl', 'geolocationControl']
        });

        // Обработчик перемещения карты
        map.events.add('actionend', function () {
            var center = map.getCenter();
            getAddress(center);
        });
    }

    function getAddress(coords) {
        var lat = coords[0];
        var lon = coords[1];
        var url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=18&addressdetails=1`;

        fetch(url)
            .then(response => response.json())
            .then(data => {
                if (data && data.address) {
                    var address = data.address;
                    document.getElementById('city-input').value = address.city || address.town || address.village || '';
                    document.getElementById('street-input').value = address.road || '';
                    document.getElementById('house-input').value = address.house_number || '';
                }
            })
            .catch(error => console.error('Ошибка при получении адреса:', error));
    }
</script>

