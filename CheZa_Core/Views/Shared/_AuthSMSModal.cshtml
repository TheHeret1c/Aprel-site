    $(document).ready(function () {
        $('#sms-modal').on('show.bs.modal', function () {
            startTimer();
            console.log('Start timer');
        });

        var email = '@ViewData["Email"]';

        console.log('Number: ', email);

        $.ajax({
            url: '/Auth/GenerateEmailCode', // Путь к вашему действию контроллера
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ email: email }),
            success: function (response) {
                // Логика обработки успешного ответа сервера
                if (response.success) {
                    // Обновляем интерфейс корзины (например, количество товаров)
                    //code = response.code;
                    console.log('Success');
                }
            },
            error: function (xhr, status, error) {
                // Логика обработки ошибок
                console.error('Error sending Email code.');
            }
        });
    });

    function closeModal() {
        document.getElementById('sms-modal').style.display = 'none';

        $('body').css({
            'overflow-y': '',
            'padding-right': ''
        });
    }

    function verifyEmailCode() {
        var code = document.getElementById('email-code').value;
        console.log('Code user: ', code);

        $.ajax({
            url: '/Auth/VerifyEmailCode', // Путь к вашему действию контроллера
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ code: code }),
            success: function (response) {
                // Логика обработки успешного ответа сервера
                if (response.success) {
                    console.log('Response: ', response);
                    alert('Удача!');
                    openProfile();
                }
                else {
                    console.log('Response: ', response);
                    alert('Неудача(');
                }
                // Обновить интерфейс корзины (например, количество товаров)
            },
            error: function (xhr, status, error) {
                // Логика обработки ошибок
                console.error('Repsonse: ', error);
            }
        });
    }

    function confirmAuth() {
        var code = document.getElementById('sms-code').value;
        console.log('Code user: ', code);

        $.ajax({
            url: '/Auth/VerifySMSCode', // Путь к вашему действию контроллера
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ code: code }),
            success: function (response) {
                // Логика обработки успешного ответа сервера
                if (response.success) {
                    console.log('Response: ', response);
                    alert('Удача!');
                    openProfile();
                }
                else {
                    console.log('Response: ', response);
                    alert('Неудача(');
                }
                // Обновить интерфейс корзины (например, количество товаров)
            },
            error: function (xhr, status, error) {
                // Логика обработки ошибок
                console.error('Repsonse: ', error);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        var timerDisplay = document.getElementById('timer');
        var resendTimeDisplay = document.getElementById('resend-time');
        var timeLeft = 60;

        function startTimer() {
            var timer = setInterval(function () {
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    timerDisplay.textContent = "00:00";
                    resendTimeDisplay.textContent = "0";
                } else {
                    timeLeft--;
                    var minutes = Math.floor(timeLeft / 60);
                    var seconds = timeLeft % 60;
                    timerDisplay.textContent = `${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                    resendTimeDisplay.textContent = timeLeft;
                }
            }, 1000);
        }

        startTimer();
    });

    function openProfile() {
        window.location.href = '@Url.Action("Profile", "Profile")';
    }
</script>
