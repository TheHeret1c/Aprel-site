@{
    var tags = Model?._product?.tags ?? new string[0];
}

@model ProductDetailsViewModel

<div id="product-modal" class="d-modal-screen">
    <div class="d-modal-container">
        @*Блок с кнопкой "Закрыть"*@
        <div class="d-modal-top">
            <img src="/Resources/crossCloseCard.svg" onclick="closeModal()" style="color: #e9e9e9;" />
        </div>
        @*Основное содержимое*@
        <div class="d-modal-content">
            @*Изображение товара*@
            <div class="d-image-part">
                <img src="@(Model._product.imageLinks != null && Model._product.imageLinks.Length > 0 ? Model._product.imageLinks[0] : "")" alt="@Model._product.name" />
            </div>
            @*Блок с описанием и модификаторами*@
            <div class="d-content-part">
                <div class="d-details">
                    @*Описание*@
                    <h2>@Model._product.name</h2>
                    <p>@Model._product.seoDescription</p>
                    <div class="comment-container">
                        <textarea id="product-comment" class="product-comment" rows="4" maxlength="200" placeholder="Введите комментарий..."></textarea>
                        <div class="comment-info">
                            Осталось символов: <span id="remaining-chars" class="remaining-chars">200</span>
                        </div>
                    </div>
                    <h4>Добавить к товару</h4>
                    @*Модификаторы*@
                    <div class="d-modifiers">
                        @foreach (var modifier in Model._modifiers)
                        {
                            <div class="d-modifier" onclick="toggleModifierSelection('@modifier.id', @modifier.sizePrices[0].price.currentPrice, this)">
                                <div class="d-modifier-image">
                                    <img src="@(modifier.imageLinks != null && modifier.imageLinks.Length > 0 ? modifier.imageLinks[0] : "")" alt="@modifier.name" />
                                    @if (tags.Length > 0 && !string.IsNullOrEmpty(tags[0]))
                                    {
                                        @if (Model._product.tags[0].Contains(modifier.name))
                                        {
                                            <div class="d-modifier-check">
                                                <img src="/Resources/checkbox-circle.svg" class="d-modifier-check-img" alt="Selected" />
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="d-modifier-details">
                                    <p>@modifier.name</p>
                                    <p>@modifier.sizePrices[0].price.currentPrice ₽</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @*Цена и кнопка "Добавить"*@
                <div class="d-modal-footer">
                    <div class="d-price">
                        <span id="total-price">@Model._product.sizePrices[0].price.currentPrice ₽</span>
                    </div>
                    <div class="d-add-cart">
                        <button class="button-continue" onclick="addToCart('@Model._product.id')">Добавить в корзину</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    var selectedModifierIds = [];
    var basePrice = @Model._product.sizePrices[0].price.currentPrice;
    var totalPrice = basePrice;

    // Закрытие окна
    function closeModal() {
        document.getElementById('product-modal').style.display = 'none';
        resetModal();

        $('body').css({
            'overflow-y': '',
            'padding-right': ''
        });

        // $('body').removeClass('modal-open');
    }

    // Выбор модификаторов
    function toggleModifierSelection(modifierId, modifierPrice, element) {
        var index = selectedModifierIds.indexOf(modifierId);

        if (index === -1) {
            selectedModifierIds.push(modifierId);
            totalPrice += modifierPrice;
            element.classList.add('selected-modifier');
        } else {
            selectedModifierIds.splice(index, 1);
            totalPrice -= modifierPrice;
            element.classList.remove('selected-modifier');
        }

        document.getElementById('total-price').innerText = totalPrice + ' ₽';
    }

    // Добавление в корзину
    function addToCart(productId) {
        var comment = document.getElementById('product-comment').value;
        console.log('Comment: ', comment);
        var orderItem = {
            ProductId: productId,
            SelectedModifiersId: selectedModifierIds,
            TotalPrice: totalPrice,
            Comment: comment
        };


        $.ajax({
            url: '/Cart/AddToCart', // Путь к вашему действию контроллера
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(orderItem),
            success: function (response) {
                // Логика обработки успешного ответа сервера
                console.log('Product added to cart:', response);
                updateButtonCart(response.cart);
            },
            error: function (xhr, status, error) {
                // Логика обработки ошибок
                console.error('Error adding product to cart:', error);
            }
        });

        closeModal();
        

        // Логика добавления продукта в корзину
        console.log(orderItem);
        closeModal();
    }

    function resetModal() {
        selectedModifierIds = [];
        totalPrice = basePrice;
        document.getElementById('total-price').innerText = totalPrice + ' ₽';
        var selectedElements = document.querySelectorAll('.selected-modifier');
        selectedElements.forEach(function (element) {
            element.classList.remove('selected-modifier');
        });
    }

    // Обновление кнопки корзины
    function createCartItemImage(item) {
        var imgElement = document.createElement('img');
        imgElement.src = item.product.imageLinks[0];
        imgElement.classList.add('cart-item-image');
        return imgElement;
    }

    // Обновление кнопки корзины
    function updateButtonCart(cart) {

        var totalQuantity = 0;

        cart.items.forEach(item => {
            totalQuantity++;
        });

        var cartItemsCount = document.querySelectorAll('.d-cart-product').length;
        cartContainer = document.getElementById('cart-container');
        var cartImagesContainer = cartContainer.querySelector('#cart-images');
        var cartCountElement = cartContainer.querySelector('#cart-quantity');
        var cartAmountElement = cartContainer.querySelector('#cart-amount');

        cartImagesContainer.innerHTML = '';
        cartCountElement.innerHTML = '';
        cartAmountElement.innerHTML = '';

        cart.items.slice(0, 3).forEach(item => {
            var imgElement = createCartItemImage(item);
            cartImagesContainer.appendChild(imgElement);
        });

        cartCountElement.textContent = totalQuantity;

        var totalAmount = 0.0;

        cart.items.forEach(item => {
            var amount = 0.0;
            amount += item.product.sizePrices[0].price.currentPrice;
            item.modifiers.forEach(modifier => {
                amount += modifier.sizePrices[0].price.currentPrice;
            });
            totalAmount += amount * item.quantity;
        });

        cartAmountElement.textContent = totalAmount + ' ₽';

        if (totalQuantity > 0) {
            console.log('Отображаю');
            cartContainer.style.display = "block"; // Отображаем корзину, если есть товары и элементы корзины
        } else {
            console.log('Не отображаю');
            cartContainer.style.display = "none"; // Скрываем корзину, если нет товаров или элементов корзины
        }
    }

    // Находим элементы на странице
    var productCommentTextarea = document.getElementById('product-comment');
    var productRemainingCharsSpan = document.getElementById('remaining-chars');

    // Функция для обновления информации о количестве оставшихся символов
    function productUpdateRemainingChars() {
        const maxLength = parseInt(productCommentTextarea.getAttribute('maxlength'));
        const currentLength = productCommentTextarea.value.length;
        const remaining = maxLength - currentLength;

        productRemainingCharsSpan.textContent = remaining;
    }

    // Слушаем событие ввода текста в поле комментария
    productCommentTextarea.addEventListener('input', productUpdateRemainingChars);

    // Инициализация при загрузке страницы (для начального значения)
    productUpdateRemainingChars();
</script>
