<div id="sms-modal" class="d-modal-screen">
    <div class="d-auth-modal-container">
        <div class="d-auth-modal-top">
            <img src="/Resources/crossCloseCard.svg" onclick="closeModal()" />
        </div>
        <div class="d-auth-modal-content">
            <div class="d-auth-content-container">
                <div class="d-auth-content-header">
                    Код подтверждения
                </div>
                <div class="d-auth-content-text">
                    @* На номер @ViewData["Phone"] отправлено смс-сообщение с
                    кодом подтверждения. Введите код и нажмите
                    «Подтвердить» *@
                    На вашу почту отправлено сообщение с<br />
                    кодом подтверждения. Введите код и нажмите<br />
                    «Подтвердить»
                </div>
                @* <div>
                    Изменить номер
                </div> *@
                <div class="sms-code-container">
                    <div class="sms-code-input">
                        @* <input type="text" id="sms-code" placeholder="Код из СМС" maxlength="4" style="background-color: transparent;"> *@
                        <input type="text" id="email-code" placeholder="Введите код" maxlength="4" style="background-color: transparent;">
                        <div class="timer">
                            <i class="fas fa-clock"></i> <span id="timer">01:00</span>
                        </div>
                    </div>
                    <div class="resend-message">Отправить повторно можно через <span id="resend-time">60</span> сек.</div>
                </div>
                <div class="d-auth-button">
                    @* <button class="button-continue" onclick="confirmAuth()">Подтвердить</button> *@
                    <button class="button-continue" onclick="verifyEmailCode()">Подтвердить</button>
                </div>
            </div>
        </div>
    </div>
</div>

