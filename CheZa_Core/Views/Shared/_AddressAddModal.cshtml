        console.log('Инициализирую карту');
        myMap = new ymaps.Map("map", {
            center: initialCoords,
            zoom: 13,
            controls: ['geolocationControl', 'zoomControl']
        });

        marker = document.querySelector('.map-marker');

        function raiseMarker() {
            if (!isZooming) { // Поднимать маркер только если нет зумирования
                console.log('Поднимаем маркер');
                marker.classList.add('raised');
            }
        }

        function lowerMarker() {
            console.log('Опускаем маркер');
            marker.classList.remove('raised');
        }

        function getAddress(coords) {
            console.log('Получаем адрес для координат:', coords);
            ymaps.geocode(coords).then(function (res) {
                var firstGeoObject = res.geoObjects.get(0);
                var addressComponents = firstGeoObject.getAddressLine().split(',');
                var cityAndStreet = addressComponents.slice(0, -1).join(',').trim();
                var houseNumber = addressComponents[addressComponents.length - 1].trim();

                console.log('Test get address:');
                var administrativeAreas = firstGeoObject.getAdministrativeAreas().join(', ');
                var locality = firstGeoObject.getLocalities().join(', ');
                var thoroughfare = firstGeoObject.getThoroughfare();
                var premiseNumber = firstGeoObject.getPremiseNumber();

                console.log("Administrative Areas:", administrativeAreas);
                console.log("Locality:", locality);
                console.log("Thoroughfare:", thoroughfare);
                console.log("Premise Number:", premiseNumber);

                document.getElementById('city-input').value = locality ? locality : "";
                document.getElementById('street-input').value = thoroughfare ? thoroughfare : "";
                document.getElementById('house-input').value = premiseNumber ? premiseNumber : "";
            });
        }

