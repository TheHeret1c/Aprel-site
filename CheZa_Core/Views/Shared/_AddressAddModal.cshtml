@model AddressViewModel

<div id="address-modal" class="d-modal-screen">
    <div class="address-modal-container">
        <div class="address-modal-top">
            <img src="/Resources/crossCloseCard.svg" onclick="closeModal()" />
        </div>
        <div class="address-modal-content">
            <div class="address-modal-content-container">
                <div class="address-modal-content-input">
                    <div class="address-modal-content-input-container">
                        <div>
                            <h2>@(Model.isEdit ? "Редактирование адреса" : "Добавление адреса")</h2>
                        </div>
                        <div class="address-modal-input">
                            <input type="text" id="city-input" placeholder="Город" class="address-input" value="@Model.city" />
                            <div id="city-suggestions" class="suggestions-container"></div>
                        </div>
                        <div class="address-modal-input">
                            <input type="text" id="street-input" placeholder="Улица" class="address-input" value="@Model.streetAddress" />
                            <div id="street-suggestions" class="suggestions-container"></div>
                        </div>
                        <div id="city-suggestions" class="suggestions-container"></div>
                        <div class="address-modal-input">
                            <div>
                                <input type="text" id="house-input" placeholder="Дом" class="address-input" value="@Model.house" />
                                <div id="house-suggestions" class="suggestions-container"></div>
                            </div>
                            <div>
                                <input type="text" id="entrance-input" placeholder="Подъезд" class="address-input" value="@Model.entrance" />
                            </div>
                        </div>
                        <div class="address-modal-input">
                            <div>
                                <input type="text" id="floor-input" placeholder="Этаж" class="address-input" value="@Model.floor" />
                            </div>
                            <div>
                                <input type="text" id="apartment-input" placeholder="Квартира" class="address-input" value="@Model.apartment" />
                            </div>
                        </div>
                        <div>
                            <input type="text" id="comment-input" placeholder="Комментарий к адресу" class="address-input" value="@Model.comment" />
                        </div>
                        <div class="button-container">
                            @if (Model.isEdit)
                            {
                                <button class="button-continue" onclick="deleteAddress()">Удалить адрес</button>
                            }
                            <button class="button-continue" onclick="submitAddress()">@(Model.isEdit ? "Сохранить изменения" : "Добавить адрес")</button>
                        </div>
                    </div>
                </div>
                <div class="address-modal-content-map">
                    <div id="map"></div>
                    <div class="map-marker"></div>
                </div>
            </div>
        </div>
    </div>
</div>


